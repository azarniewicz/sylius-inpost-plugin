{% set wrapperId = "#{ form.vars.id }_details" %}

<div
    class="bb-inpost-point d-none"
    data-bb-target="inpost-geowidget"
    data-bb-shipping-method-code="{{ azarniewicz_sylius_inpost_shipping_method_code }}"
    data-bb-save-url="{{ path('azarniewicz_sylius_inpost_plugin_shop_add_point_to_order') }}"
    data-bb-csrf-token="{{ csrf_token('azarniewicz_sylius_inpost.add_point') }}"
>
    {% if azarniewicz_sylius_inpost_geowidget_token is not empty %}
        <div class="bb-inpost-point-widget">
            <inpost-geowidget
                onpoint="azarniewicz-inpost-point-select"
                token="{{ azarniewicz_sylius_inpost_geowidget_token }}"
                language="pl"
                config="parcelCollect"
            ></inpost-geowidget>
        </div>
    {% endif %}

    {% include "@AzarniewiczSyliusInPostPlugin/InPostGeowidgetPreview.html.twig" with { order: null, wrapperId: wrapperId } %}
</div>
